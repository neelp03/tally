# Owner role: runs migrations.
DATABASE_URL=postgres://tally_owner:tally_owner@localhost:5433/tally
# App role: serves requests. Must not be a superuser or have BYPASSRLS.
APP_DATABASE_URL=postgres://tally_app:tally_app@localhost:5433/tally
SESSION_SECRET=change-me-to-a-long-random-string
PUBLIC_URL=http://localhost:5173
DEMO_MODE=true
PLATFORM_ADMIN_EMAILS=

# Optional: real billing with Stripe (test mode). Without these, billing runs in demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Optional: Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
